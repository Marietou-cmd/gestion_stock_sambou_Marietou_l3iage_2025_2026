<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.CategorieController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Catégories" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ajouterCategorie" styleClass="btn-primaire" text="+ Nouvelle catégorie" />
            </children>
        </HBox>

        <TableView fx:id="tableCategories" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="180.0" text="Nom" />
                <TableColumn fx:id="colonneDescription" prefWidth="280.0" text="Description" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="150.0" text="Nb. produits rattachés" />
                <TableColumn fx:id="colonneActions" prefWidth="180.0" text="Actions" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>