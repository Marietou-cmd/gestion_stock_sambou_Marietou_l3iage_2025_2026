<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="420.0" prefWidth="380.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.AddMouvementDialogController">
    <children>
        <Label styleClass="titre-dialog" text="Nouveau mouvement" />

        <Label text="Produit *" />
        <ComboBox fx:id="comboProduit" maxWidth="Infinity" />

        <Label text="Type de mouvement *" />
        <HBox spacing="20.0">
            <children>
                <fx:define>
                    <ToggleGroup fx:id="groupeType" />
                </fx:define>
                <RadioButton fx:id="radioEntree" mnemonicParsing="false" text="Entrée" toggleGroup="$groupeType" />
                <RadioButton fx:id="radioSortie" mnemonicParsing="false" text="Sortie" toggleGroup="$groupeType" />
            </children>
        </HBox>

        <Label text="Quantité *" />
        <TextField fx:id="champQuantite" promptText="ex: 10" />

        <Label text="Motif" />
        <TextField fx:id="champMotif" promptText="obligatoire pour une sortie" />

        <Label fx:id="labelApercu" style="-fx-text-fill: #555555; -fx-font-style: italic;" wrapText="true" />

        <Label fx:id="labelErreur" styleClass="erreur" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="boutonAnnuler" mnemonicParsing="false" onAction="#annuler" text="Annuler" />
                <Button fx:id="boutonEnregistrer" mnemonicParsing="false" onAction="#enregistrer" styleClass="btn-primaire" text="Enregistrer" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>