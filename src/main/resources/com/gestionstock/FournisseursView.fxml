<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.FournisseurController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Fournisseurs" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ajouterFournisseur" styleClass="btn-primaire" text="+ Nouveau fournisseur" />
            </children>
        </HBox>

        <TableView fx:id="tableFournisseurs" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="170.0" text="Nom" />
                <TableColumn fx:id="colonneEmail" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="colonneTel" prefWidth="120.0" text="Téléphone" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="130.0" text="Nb. produits fournis" />
                <TableColumn fx:id="colonneActions" prefWidth="180.0" text="Actions" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>