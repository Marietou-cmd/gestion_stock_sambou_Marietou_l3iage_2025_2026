<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.DashboardController">
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Tableau de bord" />

        <GridPane hgap="15.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="90.0" />
            </rowConstraints>
            <children>
                <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;" GridPane.columnIndex="0">
                    <children>
                        <Label fx:id="labelTotalProduits" style="-fx-font-size: 26px; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: #666666;" text="Produits" wrapText="true" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;" GridPane.columnIndex="1">
                    <children>
                        <Label fx:id="labelStockBas" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="0" />
                        <Label style="-fx-text-fill: #666666;" text="En stock bas" wrapText="true" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;" GridPane.columnIndex="2">
                    <children>
                        <Label fx:id="labelValeurStock" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: #666666;" text="Valeur totale du stock" wrapText="true" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;" GridPane.columnIndex="3">
                    <children>
                        <Label fx:id="labelMouvementsJour" style="-fx-font-size: 26px; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: #666666;" text="Mouvements aujourd'hui" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="⚠ Produits en stock bas" />

        <TableView fx:id="tableStockBas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="220.0" text="Nom" />
                <TableColumn fx:id="colonneStock" prefWidth="100.0" text="Stock actuel" />
                <TableColumn fx:id="colonneStockMin" prefWidth="100.0" text="Stock min." />
                <TableColumn fx:id="colonneCategorie" prefWidth="150.0" text="Catégorie" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>