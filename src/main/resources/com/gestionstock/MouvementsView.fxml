<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.MouvementController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Mouvements de stock" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ajouterMouvement" styleClass="btn-primaire" text="+ Nouveau mouvement" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Type :" />
                <ComboBox fx:id="comboFiltreType" />
                <Label text="Du :" />
                <DatePicker fx:id="datePickerDebut" />
                <Label text="Au :" />
                <DatePicker fx:id="datePickerFin" />
                <Button mnemonicParsing="false" onAction="#appliquerFiltres" text="Filtrer" />
                <Button mnemonicParsing="false" onAction="#reinitialiserFiltres" text="Réinitialiser" />
            </children>
        </HBox>

        <TableView fx:id="tableMouvements" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonneDate" prefWidth="150.0" text="Date" />
                <TableColumn fx:id="colonneProduit" prefWidth="180.0" text="Produit" />
                <TableColumn fx:id="colonneType" prefWidth="90.0" text="Type" />
                <TableColumn fx:id="colonneQuantite" prefWidth="90.0" text="Quantité" />
                <TableColumn fx:id="colonneMotif" prefWidth="180.0" text="Motif" />
                <TableColumn fx:id="colonneUtilisateur" prefWidth="150.0" text="Utilisateur" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>